---
// ─────────────────────────────────────────────
//  애드센스 광고 한 칸 (인아티클, fluid)
//  - 본문 폭에 맞춰 늘어나는 콘텐츠 내 광고. 높이는 광고가 스스로 정한다.
//  - 이전 사각형 광고 단위(3094787370)로 되돌리려면 AD_SLOT과 ins 속성을 바꾼다.
// ─────────────────────────────────────────────
const AD_CLIENT = 'ca-pub-9488002130804570';
const AD_SLOT = '4432714307';
const { lang = 'ko' } = Astro.props;
const adLabel = lang === 'en' ? 'Advertisement' : '광고';
---

<div class="ad-slot" aria-label={adLabel}>
  <span class="ad-label">{adLabel}</span>
  <ins
    class="adsbygoogle"
    style="display:block; text-align:center;"
    data-ad-layout="in-article"
    data-ad-format="fluid"
    data-ad-client={AD_CLIENT}
    data-ad-slot={AD_SLOT}
  ></ins>
</div>

<style>
  /* 인아티클 광고는 구글이 폭을 정한다(모바일에선 화면 끝까지 늘어남).
     그래서 사방 테두리 박스 대신 위아래 선으로만 본문과 구분한다.
     광고를 잘라서 박스에 맞추는 건 애드센스 정책 위반 소지가 있어 하지 않는다. */
  .ad-slot {
    margin: 2.5rem 0;
    padding: 0.75rem 0 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  /* 모바일: 광고가 화면 폭 전체로 늘어나므로 구분선도 화면 끝까지 맞춘다 */
  @media (max-width: 640px) {
    .ad-slot {
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
  }
  .ad-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  /* 인아티클 광고는 본문 폭을 그대로 쓴다 */
  .ad-slot .adsbygoogle {
    display: block;
    width: 100%;
  }
  /* 광고를 못 채운 칸은 통째로 숨김 */
  .ad-slot:has(ins[data-ad-status="unfilled"]) {
    display: none;
  }
</style>
