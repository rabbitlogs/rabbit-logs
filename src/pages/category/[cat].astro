---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSenseList from '../../components/AdSenseList.astro';

const PER_PAGE = 8;

export async function getStaticPaths() {
  return [
    { params: { cat: 'project' } },
    { params: { cat: 'operations' } },
    { params: { cat: 'study' } },
    { params: { cat: 'stats' } },
  ];
}

const { cat } = Astro.params;
const catName = { project: 'SAP 프로젝트', operations: 'SAP 실무운영', study: 'SAP 학습자료', stats: '통계·데이터' };
const catDesc = {
  project: [
    'SAP를 처음 도입하고 구축하는 과정의 기록입니다.',
    'PI 기획부터 구축, 테스트, 안정화까지 프로젝트의 큰 흐름을 다룹니다.',
  ],
  operations: [
    '구축이 끝난 뒤, 매일의 업무에서 SAP를 실제로 다루는 이야기입니다.',
    'T-CODE, 생산·재고 관리 등 현업 운영 노하우를 정리합니다.',
  ],
  study: [
    'SAP를 공부하는 사람을 위한 기초 개념과 자격증 가이드입니다.',
    '입문자가 막막해하는 지점을 실무자 관점에서 풀어냅니다.',
  ],
  stats: [
    'SAP 실무를 하다 보면 결국 데이터를 보는 눈이 필요해집니다.',
    '통계와 데이터 분석을 공부하며 남기는 기록입니다.',
  ],
};

const allPosts = (await getCollection('blog'))
  .filter((p) => p.id.startsWith('ko/') && p.data.category === cat)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const lastPage = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
const posts = allPosts.slice(0, PER_PAGE);
---

<BaseLayout title={`${catName[cat]} — Rabbit Logs`} description={catDesc[cat].join(' ')} lang="ko" showAds={true}>
  <section class="cat-list" style="padding-top: 1.2rem;">
    <h1 style="font-size: 2rem; margin: 0 0 0.6rem;">{catName[cat]}</h1>
    <p style="font-size: 0.98rem; color: var(--muted); line-height: 1.7; margin: 0 0 1.8rem;">
      {catDesc[cat].map((line, i) => (<>{i > 0 && <><br class="cat-desc-br" /> </>}{line}</>))}
    </p>
    <style>
      @media (max-width: 640px) { .cat-desc-br { display: none; } }
    </style>
    {posts.map((post, i) => (
      <>
        <PostCard
          href={`/blog/${post.id.replace('ko/', '').replace('.md', '')}`}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          pubDate={post.data.pubDate}
          lang="ko"
        />
        {/* 글 4개마다 광고 1개 (페이지 내 기준) */}
        {(i + 1) % 4 === 0 && i !== posts.length - 1 && <AdSenseList />}
      </>
    ))}

    {lastPage > 1 && (
      <nav class="pagination" aria-label="페이지 이동">
        <span class="page-btn is-disabled">← 이전</span>
        <span class="page-info">1 / {lastPage}</span>
        <a href={`/category/${cat}/2/`} class="page-btn" rel="next">다음 →</a>
      </nav>
    )}
  </section>

  <style>
    .pagination {
      display: flex; align-items: center; justify-content: center; gap: 1rem;
      margin: 2.4rem 0 1rem;
    }
    .page-btn {
      display: inline-flex; align-items: center; padding: 0.5rem 1.1rem;
      border: 1px solid var(--line, #ddd); border-radius: 8px;
      font-size: 0.95rem; color: var(--fg, #222); text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .page-btn:hover { background: var(--surface-hover, #f2f2f2); }
    .page-btn.is-disabled { color: var(--muted, #aaa); border-color: var(--line, #eee); pointer-events: none; }
    .page-info { font-size: 0.95rem; color: var(--muted, #888); min-width: 3.5rem; text-align: center; }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slots = document.querySelectorAll('.cat-list .ad-slot');
      slots.forEach((slot) => {
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}

        const ins = slot.querySelector('ins.adsbygoogle');
        if (!ins) return;

        let tries = 0;
        const checker = setInterval(() => {
          tries++;
          const status = ins.getAttribute('data-ad-status');
          const iframe = ins.querySelector('iframe');

          if (status === 'unfilled') {
            slot.remove();
            clearInterval(checker);
          } else if (iframe && iframe.offsetHeight > 0) {
            clearInterval(checker);
          } else if (tries >= 12) {
            slot.remove();
            clearInterval(checker);
          }
        }, 250);
      });
    });
  </script>
</BaseLayout>
