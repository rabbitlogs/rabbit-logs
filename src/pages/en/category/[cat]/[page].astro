---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import AdSenseList from '../../../../components/AdSenseList.astro';

const PER_PAGE = 8;

export async function getStaticPaths({ paginate }) {
  const PER_PAGE = 8;
  const cats = ['project', 'operations', 'study', 'stats'];
  const all = (await getCollection('blog')).filter((p) => p.id.startsWith('en/'));
  return cats.flatMap((cat) => {
    const posts = all
      .filter((p) => p.data.category === cat)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    // Page 1 is served by /en/category/[cat].astro → generate page 2+ only
    return paginate(posts, { params: { cat }, pageSize: PER_PAGE })
      .filter((entry) => entry.params.page && Number(entry.params.page) >= 2);
  });
}

const { cat } = Astro.params;
const { page } = Astro.props;

const catName = { project: 'SAP Projects', operations: 'SAP Operations', study: 'SAP Study Notes', stats: 'Stats & Data' };
const catDesc = {
  project: [
    'A record of the process of first adopting and implementing SAP.',
    'From PI planning to build, testing, and stabilization — the big picture of a project.',
  ],
  operations: [
    'Stories from actually working with SAP day to day, after go-live.',
    'T-codes, production and inventory management, and other hands-on operational know-how.',
  ],
  study: [
    'Foundational concepts and certification guides for anyone learning SAP.',
    'Explaining the parts beginners find confusing, from a practitioner’s point of view.',
  ],
  stats: [
    'Working with SAP eventually means you need an eye for data, too.',
    'Notes from studying statistics and data analysis alongside SAP work.',
  ],
};

const posts = page.data;
// Correct the prev link on page 2 to the base URL (/en/category/[cat]/)
const prevUrl = page.currentPage === 2 ? `/en/category/${cat}/` : page.url.prev;
---

<BaseLayout title={`${catName[cat]} — Rabbit Logs (Page ${page.currentPage})`} description={catDesc[cat].join(' ')} lang="en" showAds={true}>
  <section class="cat-list" style="padding-top: 1.2rem;">
    <h1 style="font-size: 2rem; margin: 0 0 0.6rem;">{catName[cat]}</h1>
    <p style="font-size: 0.98rem; color: var(--muted); line-height: 1.7; margin: 0 0 1.8rem;">
      {catDesc[cat].map((line, i) => (<>{i > 0 && <><br class="cat-desc-br" /> </>}{line}</>))}
    </p>
    <style>
      @media (max-width: 640px) { .cat-desc-br { display: none; } }
    </style>
    {posts.map((post, i) => (
      <>
        <PostCard
          href={`/en/blog/${post.id.replace('en/', '').replace('.md', '')}`}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          pubDate={post.data.pubDate}
          lang="en"
        />
        {(i + 1) % 4 === 0 && i !== posts.length - 1 && <AdSenseList />}
      </>
    ))}

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="Pagination">
        {prevUrl ? (
          <a href={prevUrl} class="page-btn" rel="prev">← Prev</a>
        ) : (
          <span class="page-btn is-disabled">← Prev</span>
        )}
        <span class="page-info">{page.currentPage} / {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="page-btn" rel="next">Next →</a>
        ) : (
          <span class="page-btn is-disabled">Next →</span>
        )}
      </nav>
    )}
  </section>

  <style>
    .pagination {
      display: flex; align-items: center; justify-content: center; gap: 1rem;
      margin: 2.4rem 0 1rem;
    }
    .page-btn {
      display: inline-flex; align-items: center; padding: 0.5rem 1.1rem;
      border: 1px solid var(--line, #ddd); border-radius: 8px;
      font-size: 0.95rem; color: var(--fg, #222); text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .page-btn:hover { background: var(--surface-hover, #f2f2f2); }
    .page-btn.is-disabled { color: var(--muted, #aaa); border-color: var(--line, #eee); pointer-events: none; }
    .page-info { font-size: 0.95rem; color: var(--muted, #888); min-width: 3.5rem; text-align: center; }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slots = document.querySelectorAll('.cat-list .ad-slot');
      slots.forEach((slot) => {
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}

        const ins = slot.querySelector('ins.adsbygoogle');
        if (!ins) return;

        let tries = 0;
        const checker = setInterval(() => {
          tries++;
          const status = ins.getAttribute('data-ad-status');
          const iframe = ins.querySelector('iframe');

          if (status === 'unfilled') {
            slot.remove();
            clearInterval(checker);
          } else if (iframe && iframe.offsetHeight > 0) {
            clearInterval(checker);
          } else if (tries >= 12) {
            slot.remove();
            clearInterval(checker);
          }
        }, 250);
      });
    });
  </script>
</BaseLayout>
